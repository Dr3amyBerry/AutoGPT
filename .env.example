# Generate UNIQUE random values for both; never commit real tokens.
RIGORCORE_MCP_TOKEN=replace-with-unique-random-secret-at-least-24-characters
RIGORCORE_AGENT_TOKEN=replace-with-different-random-secret-at-least-24-characters
# Optional: server also advertises local workspaces through its own built-in agent.
# RIGORCORE_LOCAL_WORKSPACES={"projects":"/srv/projects"}
# RIGORCORE_LOCAL_MODE=approve
# RIGORCORE_LOCAL_AGENT_URL=ws://127.0.0.1:8765/agents/ws
# RIGORCORE_STATE_DIR=/var/lib/rigorcore-dev
# For a reverse-proxied production hostname, required to permit MCP Host header:
# RIGORCORE_PUBLIC_HOST=dev.example.com
